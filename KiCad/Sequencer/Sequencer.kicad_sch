		(uuid "8837fe18-fc6b-4b69-9dad-1f765d149674")
	)
	(text "- Clock is a Schmitt Trigger Oscillator\n- Counter is a Decoded Decade counter (CD4017BE) IC\n- Volume are voltage dividers\n- LED & Output Buffer are Voltage Follower\n- Output Stage is a non-inverted adder & Voltage follower\n\n- Output Should be between 0V & +5V\n\n"
		(exclude_from_sim no)
		(at 82.042 191.008 0)
		(effects
